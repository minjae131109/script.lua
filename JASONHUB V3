local xrayOriginalTransparency = {}

local function applyXRay(part)

    if not part:IsA("BasePart") then
        return
    end

    if xrayOriginalTransparency[part] == nil then

        xrayOriginalTransparency[part] =
            part.LocalTransparencyModifier

    end

    part.LocalTransparencyModifier = 0.65
end

local function enableXRay()

    xrayOn = true

    for _, obj in ipairs(
        workspace:GetDescendants()
    ) do

        applyXRay(obj)
    end
end

local function disableXRay()

    xrayOn = false

    for obj, value in pairs(
        xrayOriginalTransparency
    ) do

        if obj and obj.Parent then

            obj.LocalTransparencyModifier =
                value

        end
    end

    table.clear(
        xrayOriginalTransparency
    )
end

