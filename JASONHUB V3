local espEnabled = false
local espMaxDistance = 1000
local espTeamCheck = false
local espRainbow = false
local espObjects = {}

local function getRainbowColor()

    return Color3.fromHSV(
        (tick() % 5) / 5,
        1,
        1
    )
end

local function getESPColor()

    if espRainbow then
        return getRainbowColor()
    end

    return Color3.fromRGB(
        255,
        0,
        0
    )
end

local function removeESP(target)

    local highlight =
        espObjects[target]

    if highlight then

        pcall(function()
            highlight:Destroy()
        end)

    end

    espObjects[target] = nil
end

local function makeESP(target)

    if target == player then
        return
    end

    removeESP(target)

    local character =
        target.Character

    if not character then
        return
    end

    local highlight =
        Instance.new("Highlight")

    highlight.Name =
        "JASON_ESP"

    highlight.FillTransparency =
        0.75

    highlight.OutlineTransparency =
        0

    highlight.FillColor =
        getESPColor()

    highlight.OutlineColor =
        getESPColor()

    highlight.Enabled = false

    highlight.Adornee =
        character

    highlight.Parent =
        workspace

    espObjects[target] =
        highlight
end

local function updateESP()

    local color =
        getESPColor()

    local myChar =
        player.Character

    local myRoot =
        myChar and
        myChar:FindFirstChild(
            "HumanoidRootPart"
        )

    for target, highlight in pairs(
        espObjects
    ) do

        if not highlight
            or not highlight.Parent then

            espObjects[target] = nil

            continue
        end

        if not espEnabled then

            highlight.Enabled = false

            continue
        end

        local targetChar =
            target.Character

        local targetRoot =
            targetChar and
            targetChar:FindFirstChild(
                "HumanoidRootPart"
            )

        if not targetChar
            or not targetRoot
            or not myRoot then

            highlight.Enabled = false

            continue
        end

        local distance =
            (
                targetRoot.Position
                - myRoot.Position
            ).Magnitude

        if distance > espMaxDistance then

            highlight.Enabled = false

        elseif espTeamCheck
            and target.Team
            == player.Team then

            highlight.Enabled = false

        else

            highlight.Adornee =
                targetChar

            highlight.FillColor =
                color

            highlight.OutlineColor =
                color

            highlight.Enabled = true

        end
    end
end

local function setupESPPlayer(p)

    if p == player then
        return
    end

    if p.Character then

        task.defer(function()
            makeESP(p)
        end)

    end

    p.CharacterAdded:Connect(
        function()

            task.wait(0.2)

            if espEnabled
                or not espObjects[p] then

                makeESP(p)

            end
        end
    )
end

for _, p in ipairs(
    Players:GetPlayers()
) do

    setupESPPlayer(p)

end

Players.PlayerAdded:Connect(
    function(p)
        setupESPPlayer(p)
    end
)

Players.PlayerRemoving:Connect(
    function(p)
        removeESP(p)
    end
)

RunService.RenderStepped:Connect(
    updateESP
)

