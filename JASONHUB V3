    game.CoreGui

local FOVCircle =
    Instance.new("Frame")

FOVCircle.BackgroundTransparency = 1
FOVCircle.Visible = false
FOVCircle.Parent = AimGui

local corner =
    Instance.new("UICorner")

corner.CornerRadius =
    UDim.new(1,0)

corner.Parent =
    FOVCircle

local stroke =
    Instance.new("UIStroke")

stroke.Thickness = 2

stroke.Color =
    Color3.fromRGB(
        0,
        255,
        0
    )

stroke.Parent =
    FOVCircle

local function getClosest()

    local camera =
        workspace.CurrentCamera

    if not camera then
        return
    end

    local center =
        camera.ViewportSize / 2

    local closest
    local shortest = AimFOV

    for _, target in ipairs(
        Players:GetPlayers()
    ) do

        if target ~= player
            and target.Character then

            local hum =
                target.Character:
                FindFirstChildOfClass(
                    "Humanoid"
                )

            local head =
                target.Character:
                FindFirstChild(
                    "Head"
                )

            if hum
                and hum.Health > 0
                and head then

                if AimTeamCheck
                    and target.Team
                    == player.Team then

                    continue
                end

                local pos, onScreen =
                    camera:WorldToViewportPoint(
                        head.Position
                    )

                if onScreen then

                    local distance =
                        (
                            Vector2.new(
                                pos.X,
                                pos.Y
                            ) - center
                        ).Magnitude

                    local worldDistance =
                        (
                            head.Position
                            - camera.CFrame.Position
                        ).Magnitude

                    if distance < shortest
                        and worldDistance
                        <= AimDistance then

                        closest =
                            target

                        shortest =
                            distance

                    end
                end
            end
        end
    end

    return closest
end

RunService.RenderStepped:Connect(
    function()

        local camera =
            workspace.CurrentCamera

        if not camera then
            return
        end

        FOVCircle.Size =
            UDim2.fromOffset(
                AimFOV * 2,
                AimFOV * 2
            )

        FOVCircle.Position =
            UDim2.new(
                0.5,
                -AimFOV,
                0.5,
                -AimFOV
            )

        FOVCircle.Visible =
            AimEnabled

        if not AimEnabled then
            return
        end

        local target =
            getClosest()

        if target
            and target.Character then

            local head =
                target.Character:
                FindFirstChild(
                    "Head"
                )

            if head then

                local targetCF =
                    CFrame.new(
                        camera.CFrame.Position,
                        head.Position
                    )

                camera.CFrame =
                    camera.CFrame:Lerp(
                        targetCF,
                        AimSmooth
                    )

                stroke.Color =
                    Color3.fromRGB(
                        255,
                        0,
                        0
                    )
            end

        else

            stroke.Color =
                Color3.fromRGB(
                    0,
                    255,
                    0
                )
        end
    end
)

