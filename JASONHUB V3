local originalLighting = {}
local lightingSaved = false

local shaderEffects = {}

local shaderLightingSaved = false
local shaderOriginalGlobalShadows = nil
local shaderOriginalDiffuse = nil
local shaderOriginalSpecular = nil
local shaderOriginalTechnology = nil

local function saveLighting()
    if lightingSaved then
        return
    end

    pcall(function()
        originalLighting.Brightness =
            Lighting.Brightness

        originalLighting.ClockTime =
            Lighting.ClockTime

        originalLighting.FogEnd =
            Lighting.FogEnd

        originalLighting.FogStart =
            Lighting.FogStart

        originalLighting.GlobalShadows =
            Lighting.GlobalShadows

        originalLighting.OutdoorAmbient =
            Lighting.OutdoorAmbient

        originalLighting.Ambient =
            Lighting.Ambient

        if Lighting.EnvironmentDiffuseScale ~= nil then
            originalLighting.EnvironmentDiffuseScale =
                Lighting.EnvironmentDiffuseScale
        end

        if Lighting.EnvironmentSpecularScale ~= nil then
            originalLighting.EnvironmentSpecularScale =
                Lighting.EnvironmentSpecularScale
        end

        if Lighting.Technology ~= nil then
            originalLighting.Technology =
                Lighting.Technology
        end
    end)

    lightingSaved = true
end

local function saveShaderLighting()
    if shaderLightingSaved then
        return
    end

    pcall(function()
        shaderOriginalGlobalShadows =
            Lighting.GlobalShadows

        if Lighting.EnvironmentDiffuseScale ~= nil then
            shaderOriginalDiffuse =
                Lighting.EnvironmentDiffuseScale
        end

        if Lighting.EnvironmentSpecularScale ~= nil then
            shaderOriginalSpecular =
                Lighting.EnvironmentSpecularScale
        end

        if Lighting.Technology ~= nil then
            shaderOriginalTechnology =
                Lighting.Technology
        end
    end)

    shaderLightingSaved = true
end

--==================================================
-- FULLBRIGHT
--==================================================

local function enableFullbright()

    saveLighting()

    fullbrightOn = true

    if shaderOn then
        shaderOn = false

        for _, effect in pairs(shaderEffects) do
            pcall(function()
                effect:Destroy()
            end)
        end

        table.clear(shaderEffects)

        if shaderLightingSaved then
            pcall(function()
                Lighting.GlobalShadows =
                    shaderOriginalGlobalShadows

                if shaderOriginalDiffuse ~= nil then
                    Lighting.EnvironmentDiffuseScale =
                        shaderOriginalDiffuse
                end

                if shaderOriginalSpecular ~= nil then
                    Lighting.EnvironmentSpecularScale =
                        shaderOriginalSpecular
                end

                if shaderOriginalTechnology ~= nil then
                    Lighting.Technology =
                        shaderOriginalTechnology
                end
            end)

            shaderLightingSaved = false
        end
    end

    pcall(function()

        Lighting.Brightness = 10
        Lighting.ClockTime = 12
        Lighting.FogEnd = 100000
        Lighting.FogStart = 0

        Lighting.GlobalShadows = false

        Lighting.OutdoorAmbient =
            Color3.fromRGB(
                255,
                255,
                255
            )

        Lighting.Ambient =
            Color3.fromRGB(
                255,
                255,
                255
            )

        if Lighting.EnvironmentDiffuseScale ~= nil then
            Lighting.EnvironmentDiffuseScale = 1
        end

        if Lighting.EnvironmentSpecularScale ~= nil then
            Lighting.EnvironmentSpecularScale = 1
        end

    end)
end

local function disableFullbright()

    fullbrightOn = false

    if not lightingSaved then
        return
    end

    pcall(function()

        Lighting.Brightness =
            originalLighting.Brightness

        Lighting.ClockTime =
            originalLighting.ClockTime

        Lighting.FogEnd =
            originalLighting.FogEnd

        Lighting.FogStart =
            originalLighting.FogStart

        Lighting.GlobalShadows =
            originalLighting.GlobalShadows

        Lighting.OutdoorAmbient =
            originalLighting.OutdoorAmbient

        Lighting.Ambient =
            originalLighting.Ambient

        if originalLighting.EnvironmentDiffuseScale ~= nil then
            Lighting.EnvironmentDiffuseScale =
                originalLighting.EnvironmentDiffuseScale
        end

        if originalLighting.EnvironmentSpecularScale ~= nil then
            Lighting.EnvironmentSpecularScale =
                originalLighting.EnvironmentSpecularScale
        end

        if originalLighting.Technology ~= nil then
            Lighting.Technology =
                originalLighting.Technology
        end

    end)
end

--==================================================
-- SHADER
--==================================================

local function createShader()

    if fullbrightOn then
        disableFullbright()
    end

    for _, effect in pairs(shaderEffects) do
        pcall(function()
            effect:Destroy()
        end)
    end

    table.clear(shaderEffects)

    saveShaderLighting()

    pcall(function()

        Lighting.GlobalShadows = true

        if Lighting.Technology ~= nil then
            pcall(function()
                Lighting.Technology =
                    Enum.Technology.Future
            end)
        end

        if Lighting.EnvironmentDiffuseScale ~= nil then
            Lighting.EnvironmentDiffuseScale =
                0.35
        end

        if Lighting.EnvironmentSpecularScale ~= nil then
            Lighting.EnvironmentSpecularScale =
                0.45
        end

    end)

    local color =
        Instance.new("ColorCorrectionEffect")

    color.Name =
        "JASON_SHADER_COLOR"

    color.Contrast = 0.35
    color.Saturation = 0.18
    color.Brightness = -0.03
    color.Parent = Lighting

    local bloom =
        Instance.new("BloomEffect")

    bloom.Name =
        "JASON_SHADER_BLOOM"

    bloom.Intensity = 0.12
    bloom.Size = 18
    bloom.Threshold = 1.4
    bloom.Parent = Lighting

    local rays =
        Instance.new("SunRaysEffect")

    rays.Name =
        "JASON_SHADER_RAYS"

    rays.Intensity = 0.10
    rays.Spread = 0.75
    rays.Parent = Lighting

    shaderEffects.Color = color
    shaderEffects.Bloom = bloom
    shaderEffects.Rays = rays
end

local function removeShader()

    for _, effect in pairs(shaderEffects) do
        if effect then
            pcall(function()
                effect:Destroy()
            end)
        end
    end

    table.clear(shaderEffects)

    if shaderLightingSaved then

        pcall(function()

            if shaderOriginalGlobalShadows ~= nil then
                Lighting.GlobalShadows =
                    shaderOriginalGlobalShadows
            end

            if shaderOriginalDiffuse ~= nil then
                Lighting.EnvironmentDiffuseScale =
                    shaderOriginalDiffuse
            end

            if shaderOriginalSpecular ~= nil then
                Lighting.EnvironmentSpecularScale =
                    shaderOriginalSpecular
            end

            if shaderOriginalTechnology ~= nil then
                Lighting.Technology =
                    shaderOriginalTechnology
            end

        end)

        shaderLightingSaved = false
    end
end

