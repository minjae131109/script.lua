local InfoTab =
    Window:CreateTab(
        "Info",
        4483362458
    )

local infoParagraph =
    InfoTab:CreateParagraph({

        Title =
            "JASONHUB V3",

        Content =
            "FPS / Ping 정보를 불러오는 중..."

    })

task.spawn(function()

    while task.wait(1) do

        local fps = 0

        pcall(function()

            local dt =
                RunService.RenderStepped:Wait()

            fps =
                math.floor(
                    1 /
                    math.max(
                        dt,
                        0.001
                    )
                )

        end)

        local ping = 0

        pcall(function()

            ping =
                math.floor(
                    player:GetNetworkPing()
                    * 1000
                )

        end)

        pcall(function()

            infoParagraph:Set({

                Title =
                    "JASONHUB V3",

                Content =
                    "FPS: "
                    .. tostring(fps)

                    .. "\nPing: "
                    .. tostring(ping)
                    .. " ms"

                    .. "\nPlayers: "
                    .. tostring(
                        #Players:GetPlayers()
                    )
            })

        end)
    end
end)

