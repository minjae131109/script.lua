local chams = {}

local function createCham(target)

    if target == player then
        return
    end

    if chams[target] then

        pcall(function()
            chams[target]:Destroy()
        end)

        chams[target] = nil
    end

    if not target.Character then
        return
    end

    local highlight =
        Instance.new("Highlight")

    highlight.Name =
        "JASON_CHAMS"

    highlight.FillColor =
        Color3.fromRGB(
            255,
            0,
            0
        )

    highlight.OutlineColor =
        Color3.fromRGB(
            255,
            0,
            0
        )

    highlight.FillTransparency = 0.5
    highlight.OutlineTransparency = 0
    highlight.Enabled = chamsOn
    highlight.Adornee =
        target.Character

    highlight.Parent =
        target.Character

    chams[target] =
        highlight
end

for _, p in ipairs(
    Players:GetPlayers()
) do

    if p ~= player then

        createCham(p)

        p.CharacterAdded:Connect(
            function()

                task.wait(0.2)

                createCham(p)

            end
        )
    end
end

Players.PlayerAdded:Connect(
    function(p)

        if p == player then
            return
        end

        p.CharacterAdded:Connect(
            function()

                task.wait(0.2)

                createCham(p)

            end
        )
    end
)

Players.PlayerRemoving:Connect(
    function(p)

