            255
        )

    frame.BorderSizePixel = 0
    frame.Parent =
        CrosshairGui

    table.insert(
        crossParts,
        frame
    )
end

local function updateCrosshair()

    local camera =
        workspace.CurrentCamera

    if not camera then
        return
    end

    local center =
        camera.ViewportSize / 2

    local size = 8
    local thickness = 2

    crossParts[1].Size =
        UDim2.fromOffset(
            thickness,
            size
        )

    crossParts[1].Position =
        UDim2.fromOffset(
            center.X - thickness/2,
            center.Y - size - 3
        )

    crossParts[2].Size =
        UDim2.fromOffset(
            thickness,
            size
        )

    crossParts[2].Position =
        UDim2.fromOffset(
            center.X - thickness/2,
            center.Y + 3
        )

    crossParts[3].Size =
        UDim2.fromOffset(
            size,
            thickness
        )

    crossParts[3].Position =
        UDim2.fromOffset(
            center.X - size - 3,
            center.Y - thickness/2
        )

    crossParts[4].Size =
        UDim2.fromOffset(
            size,
            thickness
        )

    crossParts[4].Position =
        UDim2.fromOffset(
            center.X + 3,
            center.Y - thickness/2
        )

    for _, part in ipairs(crossParts) do
        part.Visible =
            crosshairOn
    end
end

RunService.RenderStepped:Connect(
    updateCrosshair
)

